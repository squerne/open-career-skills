# PRIVACY GUARD: personal career data never gets committed, even on public forks.
# Templates and docs are tracked; your filled-in copies are not.
profile/*.md
!profile/*.template.md
# your writing voice (built by /voice); already covered by profile/*.md, listed so it is never un-ignored by accident
profile/voice.md
story-bank/*.md
!story-bank/README.md
!story-bank/example-story.md
content/calendar.md
tracker/*.md
!tracker/*.template.md
# what tools/scan.mjs has already shown you
tracker/seen.tsv

# Generated assets (CVs, cover letters, interview debriefs); keep the folder, ignore its contents
output/*
!output/.gitkeep
# drafts waiting for you to send (from /outcome); covered by output/*, listed so it stays ignored
output/outbox/

# Launch material, not part of the public repo
.launch/

# Local user documents (create this folder for CV exports etc.)
documents/

# Claude Code's own per-machine approvals ("don't ask again" answers)
.claude/settings.local.json

# OS noise
.DS_Store
